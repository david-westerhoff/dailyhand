{
  // Daily Hand: Worker (API unter /api) plus statische Seite aus public/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dailyhand",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dailyhand",
      // angelegt 24.11.2026 in Westeuropa (--location weur)
      "database_id": "e834938e-cad9-4636-a6ef-13f68aa2a57a",
      "migrations_dir": "migrations"
    }
  ],
  // täglich aufräumen: abgelaufene Codes und Sitzungen, lange inaktive Gastkonten
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "MAIL_MODE": "resend",
    "MAIL_FROM": "Daily Hand <login@example.com>"
  },
  "observability": { "enabled": false }
}
